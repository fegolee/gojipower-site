# Pages caches /assets/* for 14400s while index.html revalidates every time.
# Since the stylesheet and script were extracted, that meant new HTML could run
# against a script up to four hours old. curl never shows it: no browser cache.
# no-cache means revalidate, not don't store -- with the ETag, unchanged is a 304.
/assets/site.js
  Cache-Control: no-cache
/assets/site.css
  Cache-Control: no-cache
